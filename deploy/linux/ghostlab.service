[Unit]
Description=GHOSTLAB // Vaporware Graveyard (.NET 8 + React 3D)
After=network.target

[Service]
Type=simple
User=ducne
WorkingDirectory=/opt/ghostlab
ExecStart=/opt/ghostlab/GhostLab
Restart=always
RestartSec=5
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://0.0.0.0:5293
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=0

[Install]
WantedBy=multi-user.target
